# ==========================================
loader/
*/loader/
packages/*/loader/
www/
*/www/
packages/*/www/
.stencil/
*/.stencil/
packages/*/.stencil/
*.tsbuildinfo

# Stencil auto-generated typings & component README files
packages/stencil-library/src/components.d.ts
packages/stencil-library/src/components/**/readme.md
packages/stencil-library/src/components/**/README.md

