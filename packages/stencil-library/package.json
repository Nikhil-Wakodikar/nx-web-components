{
  "name": "stencil-library",
  "version": "1.0.0",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stencil-library/stencil-library.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/stencil-component-starter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pack-lib-stencil-library": "cd dist/ && npm pack",
    "release-notes": "node scripts/update-release-notes.js",
    "release-notes:preview": "node scripts/update-release-notes.js --since=HEAD~10"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.3",
    "@stencil/angular-output-target": "^0.10.2",
    "@stencil/core": "^4.7.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-mdx-gfm": "^8.4.7",
    "@storybook/addon-webpack5-compiler-swc": "^2.0.0",
    "@storybook/blocks": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@storybook/web-components": "^8.4.7",
    "@storybook/web-components-vite": "^8.4.7",
    "@storybook/web-components-webpack5": "^8.4.7",
    "@types/jest": "^29.5.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "^16.18.11",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "lit": "^3.2.1",
    "puppeteer": "^21.9.0",
    "storybook": "^8.4.7",
    "webpack-retry-chunk-load-plugin": "^3.1.1",
    "workbox-build": "^4.3.1"
  },
  "license": "MIT",
  "dependencies": {
    "@stencil/sass": "^3.0.12",
    "sass": "^1.85.1"
  }
}
