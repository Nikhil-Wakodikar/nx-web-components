{
  "name": "@_nx/stencil-library",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.3",
  "description": "NX Web Components - Reusable, accessible UI components built with Stencil",
  "homepage": "https://nikhil-wakodikar.github.io/nx-web-components/?path=/docs/nx-web-components-select--docs",
  "author": "Nikhil Wakodikar",
  "keywords": [
    "web-components",
    "stencil",
    "ui-components",
    "design-system",
    "nx"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stencil-library/stencil-library.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./angular": {
      "types": "./angular/index.d.ts",
      "esm2022": "./angular/esm2022/_nx-component-library.mjs",
      "esm": "./angular/esm2022/_nx-component-library.mjs",
      "default": "./angular/fesm2022/_nx-component-library.mjs"
    },
    "./components/*": "./components/*",
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./styles.css": "./dist/stencil-library/stencil-library.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikhil-Wakodikar/nx-web-components.git",
    "directory": "packages/stencil-library"
  },
  "files": [
    "dist/",
    "loader/",
    "components/",
    "angular/"
  ],
  "peerDependencies": {
    "@angular/common": ">=16.0.0",
    "@angular/core": ">=16.0.0",
    "@angular/forms": ">=16.0.0",
    "@angular/platform-browser": ">=16.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "scripts": {
    "build": "stencil build && node scripts/clean-angular-events.js && ng-packagr -p ../angular-workspace/projects/component-library/ng-package.json && node scripts/generate-storybook-custom-elements.js",
    "build:stencil": "stencil build",
    "build:angular": "node scripts/clean-angular-events.js && ng-packagr -p ../angular-workspace/projects/component-library/ng-package.json",
    "postbuild": "node scripts/clean-angular-events.js && node scripts/generate-storybook-custom-elements.js",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pack-lib-stencil-library": "npm pack",
    "release-notes": "node scripts/update-release-notes.js",
    "release-notes:preview": "node scripts/update-release-notes.js --since=HEAD~10"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.3",
    "@stencil/angular-output-target": "^0.10.2",
    "@stencil/core": "^4.7.0",
    "ng-packagr": "^16.2.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-mdx-gfm": "^8.4.7",
    "@storybook/addon-webpack5-compiler-swc": "^2.0.0",
    "@storybook/blocks": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@storybook/web-components": "^8.4.7",
    "@storybook/web-components-vite": "^8.4.7",
    "@storybook/web-components-webpack5": "^8.4.7",
    "@types/jest": "^29.5.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "^16.18.11",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "lit": "^3.2.1",
    "puppeteer": "^21.9.0",
    "storybook": "^8.4.7",
    "webpack-retry-chunk-load-plugin": "^3.1.1",
    "workbox-build": "^4.3.1"
  },
  "license": "MIT",
  "dependencies": {
    "@stencil/sass": "^3.0.12",
    "lucide": "^1.52.0",
    "sass": "^1.85.1"
  }
}
